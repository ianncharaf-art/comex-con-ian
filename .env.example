# Variables opcionales para Vercel (Settings > Environment Variables). Nada de esto es obligatorio:
# sin estas claves la web funciona igual y el Asistente NCM usa el nomenclador local.

# Asistente NCM con IA: clave gratuita de Google AI Studio (aistudio.google.com/apikey)
GEMINI_API_KEY=
# Modelo (opcional)
GEMINI_MODEL=gemini-2.5-flash
# Consultas con IA por persona por día (opcional, por defecto 10)
NCM_LIMITE_DIARIO=10

# Contador global del límite diario (opcional): base gratuita de Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Clave del Centro privado (/centro). Ya existe; no la pongas en el repo.
CENTRO_CLAVE=
